  <!-- ===========================
       MODAL TAMBAH / EDIT DATA
  =========================== -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="modal">
      <div class="modal-header">
        <h3 id="modalTitle">Tambah Data</h3>
        <button class="modal-close" id="modalClose" aria-label="Tutup">✕</button>
      </div>
      <form class="modal-body" id="dataForm" novalidate>
        <input type="hidden" id="editNimOriginal" />

        <div class="form-group">
          <label for="fNim">NIM/ID <span class="req">*</span></label>
          <input type="text" id="fNim" class="form-control" placeholder="Contoh: 25210001" maxlength="20" />
          <span class="field-error" id="errNim"></span>
        </div>

        <div class="form-group">
          <label for="fNama">Nama <span class="req">*</span></label>
          <input type="text" id="fNama" class="form-control" placeholder="Nama lengkap" maxlength="60" />
          <span class="field-error" id="errNama"></span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="fNilai" id="labelNilai">Nilai (0–100) <span class="req">*</span></label>
            <input type="number" id="fNilai" class="form-control" placeholder="0–100" min="0" max="100" />
            <span class="field-error" id="errNilai"></span>
          </div>
          <div class="form-group">
            <label for="fKehadiran">Kehadiran % (0–100) <span class="req">*</span></label>
            <input type="number" id="fKehadiran" class="form-control" placeholder="0–100" min="0" max="100" />
            <span class="field-error" id="errKehadiran"></span>
          </div>
        </div>

        <div class="form-group" id="formGroupOrg">
          <label>Status Organisasi <span class="req">*</span></label>
          <div class="radio-group">
            <label class="radio-label">
              <input type="radio" name="fOrganisasi" value="Ya" /> Ya
            </label>
            <label class="radio-label">
              <input type="radio" name="fOrganisasi" value="Tidak" checked /> Tidak
            </label>
          </div>
        </div>

        <!-- Dataset 2 tambahan: seminar, workshop, kompetisi -->
        <div class="form-group hidden" id="formGroupSeminar">
          <label>Seminar Teknologi</label>
          <div class="radio-group">
            <label class="radio-label"><input type="radio" name="fSeminar" value="Ya" /> Ya</label>
            <label class="radio-label"><input type="radio" name="fSeminar" value="Tidak" checked /> Tidak</label>
          </div>
        </div>
        <div class="form-group hidden" id="formGroupWorkshop">
          <label>Workshop Pemrograman</label>
          <div class="radio-group">
            <label class="radio-label"><input type="radio" name="fWorkshop" value="Ya" /> Ya</label>
            <label class="radio-label"><input type="radio" name="fWorkshop" value="Tidak" checked /> Tidak</label>
          </div>
        </div>
        <div class="form-group hidden" id="formGroupKompetisi">
          <label>Kompetisi IT</label>
          <div class="radio-group">
            <label class="radio-label"><input type="radio" name="fKompetisi" value="Ya" /> Ya</label>
            <label class="radio-label"><input type="radio" name="fKompetisi" value="Tidak" checked /> Tidak</label>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn--outline" id="btnModalCancel">Batal</button>
          <button type="submit" class="btn btn--primary" id="btnModalSave">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===========================
       TOAST NOTIFICATION
  =========================== -->
  <div class="toast-container" id="toastContainer"></div>

